{
	"name": "job-radar",
	"productName": "Job Radar",
	"version": "0.1.2",
	"description": "Jobs that fit your resume, the moment companies post them.",
	"author": "Job Radar",
	"private": true,
	"type": "module",
	"main": "dist-desktop/main.mjs",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"start": "tsx src/backend/server.ts",
		"ui": "vite",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"desktop:build": "node scripts/build-desktop.mjs && vite build",
		"desktop": "node scripts/build-desktop.mjs && vite build && electron .",
		"desktop:pack": "node scripts/release.mjs --dir",
		"release": "node scripts/release.mjs",
		"desktop:art": "electron scripts/render-icons.cjs && electron scripts/render-installer-art.cjs"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@rivet-dev/claude-code": "link:../rivet/integrations/claude-code",
		"@rivetkit/react": "link:../rivet/rivetkit-typescript/packages/react",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.13.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-react": "^4.3.4",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"electron": "^44.9.1",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"fast-xml-parser": "^4.5.7",
		"lucide-react": "^1.60.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rivetkit": "link:../rivet/rivetkit-typescript/packages/rivetkit",
		"selfsigned": "^2.4.1",
		"shadcn": "^4.22.1",
		"sonner": "^2.0.8",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.5.2",
		"vite": "^5.4.11",
		"vitest": "3.2.4",
		"web-push": "^3.6.7",
		"zod": "4.3.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"esbuild"
		]
	}
}
