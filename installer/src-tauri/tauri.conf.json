{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Job Radar Setup",
	"version": "0.1.2",
	"identifier": "dev.jobradar.setup",
	"build": { "frontendDist": "../ui" },
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Install Job Radar",
				"width": 440,
				"height": 540,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"center": true
			}
		],
		"security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'" }
	},
	"bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
